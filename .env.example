# Neon → Project → Connection Details → copy the pooled connection string
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Password for the admin dashboard
ADMIN_PASSWORD=change-this-password
# Long random string used to sign admin sessions (e.g. `openssl rand -hex 32`)
SESSION_SECRET=replace-with-a-long-random-string
# Public address used inside QR codes, e.g. https://cla-youth.vercel.app (optional — defaults to the current host)
SITE_URL=
# Name shown on the check-in page
NEXT_PUBLIC_ORG_NAME=CLA Youth
# Flag someone for follow-up after this many programmes missed in a row
FOLLOW_UP_AFTER=3
# Timezone used to decide what "today" is
APP_TIMEZONE=Africa/Lagos

# Shared code facilitators enter once to take their room roll at /rooms
FACILITATOR_CODE=123456
